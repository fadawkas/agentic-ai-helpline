# Application
APP_NAME=voice-support
APP_ENV=development
APP_DEBUG=true

# API and frontend
BACKEND_PORT=8000
FRONTEND_PORT=5173

# PostgreSQL
POSTGRES_USER=voice_support
POSTGRES_PASSWORD=
POSTGRES_DATABASE=voice_support

# Qdrant
QDRANT_URL=http://qdrant:6333

# Asterisk — set LAN values for Linphone on another device
ASTERISK_SIP_PORT=5060
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=10100
ASTERISK_LOCAL_NETWORK=
ASTERISK_EXTERNAL_ADDRESS=
ASTERISK_SIP_USERNAME=1001
ASTERISK_SIP_PASSWORD=
ASTERISK_AI_EXTENSION=7000

# ARI (internal only; used in later phases)
ASTERISK_ARI_URL=http://asterisk:8088/ari
ASTERISK_ARI_USERNAME=voice_support
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=voice-support
ASTERISK_AI_EXTENSION=7000
ASTERISK_MEDIA_WEBSOCKET_CLIENT=voice_support_media
ASTERISK_MEDIA_FORMAT=slin16
VOICE_SAMPLE_RATE=16000

# Phase 3 — set true after supplying provider credentials and Fish voice ID
VOICE_AGENT_ENABLED=false

# Phase 3 — direct provider API credentials and models
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=id

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_CONVERSATION_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_CLASSIFIER_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_MAX_OUTPUT_TOKENS=1000
CONVERSATION_CONTEXT_MAX_TURNS=30
JEV_INITIAL_PERSONALITY=NEUTRAL
JEV_CLASSIFICATION_WARMUP_TURNS=3
JEV_CONFIDENCE_THRESHOLD=0.80
JEV_SWITCH_STABILITY_TURNS=2

FISH_AUDIO_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free
FISH_REFERENCE_ID=
FISH_TTS_LANGUAGE=id
FISH_TTS_LATENCY=balanced

# Curated RAG knowledge collection (uses OpenRouter credentials)
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-large
RAG_EMBEDDING_DIMENSIONS=1024
RAG_COLLECTION_NAME=voice_support_knowledge_v1
RAG_MIN_SIMILARITY=0.45
RAG_MAX_RESULTS=4
RAG_QUERY_REWRITE_ENABLED=true
RAG_RERANK_MIN_SCORE=0.4
RAG_RERANK_MODEL=cohere/rerank-4-fast

# Admin knowledge management (set unique values before enabling the dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
KNOWLEDGE_MAX_UPLOAD_BYTES=20000000
